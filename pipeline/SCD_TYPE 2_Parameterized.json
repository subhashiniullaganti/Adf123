													"value": "@item().sink_tablename",
													"type": "Expression"
												},
												"direction": "Input"
											},
											{
												"name": "primarykey",
												"type": "String",
												"value": {
													"value": "@item().primary_key",
													"type": "Expression"
												},
												"direction": "Input"
											},
											{
												"name": "recon_name",
												"type": "String",
												"value": {
													"value": "@item().recon_name",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "Query",
										"text": {
											"value": "SELECT CASE WHEN COUNT(1) = 0 THEN 'RECON_SUCCEDED' ELSE 'RECON_FAILED' END AS RECON_RESULT\nFROM\n(\nselect sum(@{item().primary_key}) as primarykey, sum(cast(checksum(substring(cast(@{item().Recon_name} as varchar(200)),2,3)) as bigint)) as recon_name from @{item().schema_name}.@{item().table_name}\nexcept\nselect sum(@{item().primary_key}) as primarykey, sum(cast(checksum(substring(cast(@{item().Recon_name} as varchar(200)),2,3)) as bigint)) as recon_name from @{item().schema_name}.@{item().table_name}\n) RECON;\n",
											"type": "Expression"
										}
									},
									{
										"parameters": [
											{
												"name": "source_schema",
												"type": "String",
												"value": {
													"value": "@item().schema_name",
													"type": "Expression"
												},
												"direction": "Input"
											},
											{
												"name": "source_table_name",
												"type": "String",
												"value": {
