												},
												"direction": "Input"
											}
										],
										"type": "Query",
										"text": {
											"value": "select count(*) as source_count from @{item().schema_name}.@{item().table_name}",
											"type": "Expression"
										}
									},
									{
										"parameters": [
											{
												"name": "sink_schema",
												"type": "String",
												"value": {
													"value": "@item().sink_schemaname",
													"type": "Expression"
												},
												"direction": "Input"
											},
											{
												"name": "sink_table_name",
												"type": "String",
												"value": {
													"value": "@item().sink_tablename",
													"type": "Expression"
												},
												"direction": "Input"
											}
										],
										"type": "Query",
										"text": {
											"value": "select count(*) as sink_count from @{item().sink_schemaname}.@{item().sink_tablename};",
											"type": "Expression"
