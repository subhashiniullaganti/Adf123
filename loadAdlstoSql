-- ============================================================
-- ADF Metadata Control Table
-- Run in Azure SQL DB before executing ADF pipeline
-- ============================================================

CREATE TABLE dbo.adf_excel_config (
    config_id       INT IDENTITY(1,1) PRIMARY KEY,
    file_name       NVARCHAR(255)   NOT NULL,
    container_name  NVARCHAR(100)   NOT NULL,
    folder_path     NVARCHAR(500)   NOT NULL,
    sheet_name      NVARCHAR(100)   NOT NULL,
    target_schema   NVARCHAR(50)    DEFAULT 'dbo',
    target_table    NVARCHAR(100)   NOT NULL,
    write_mode      NVARCHAR(20)    DEFAULT 'overwrite',
    is_active       BIT             DEFAULT 1,
    load_status     NVARCHAR(20)    DEFAULT 'Pending',
    last_load_date  DATETIME        NULL,
    rows_loaded     INT             NULL,
    error_message   NVARCHAR(MAX)   NULL,
    created_date    DATETIME        DEFAULT GETDATE()
);
GO

