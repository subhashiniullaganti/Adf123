-- Status update stored procedure
CREATE PROCEDURE dbo.usp_update_load_status
    @config_id     INT,
    @load_status   NVARCHAR(20),
    @rows_loaded   INT           = NULL,
    @error_message NVARCHAR(MAX) = NULL
AS
BEGIN
    UPDATE dbo.adf_excel_config
    SET
        load_status    = @load_status,
        last_load_date = GETDATE(),
        rows_loaded    = @rows_loaded,
        error_message  = @error_message
    WHERE config_id = @config_id;
END;
GO

-- Check load results
SELECT
    config_id,
    file_name,
    sheet_name,
    target_table,
    load_status,
    rows_loaded,
    last_load_date,
    error_message
FROM dbo.adf_excel_config
ORDER BY last_load_date DESC;
